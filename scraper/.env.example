# IXL parent account credentials
IXL_USERNAME=your_parent_email@example.com
IXL_PASSWORD=yourpassword

# IXL domain (use ca.ixl.com if you're in Canada)
IXL_BASE_URL=https://ca.ixl.com

# Comma-separated child names exactly as they appear in IXL
# e.g. Kirse,Lucas,Sansa
IXL_STUDENT_NAMES=Kirse,Lucas,Sansa

# Shared secret - must match IXL_SYNC_SECRET in your Convex dashboard
IXL_SYNC_SECRET=generate-a-long-random-string-here

# Your Convex deployment URL (from .env.local in the main app)
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
